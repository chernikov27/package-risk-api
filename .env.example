AGENTSPEC_PAYMENT_MODE=on
AGENTSPEC_PAY_TO=0xYour42CharacterEvmWalletAddress

# Coinbase CDP Facilitator for Base mainnet.
AGENTSPEC_X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
AGENTSPEC_X402_NETWORK=eip155:8453
AGENTSPEC_X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
AGENTSPEC_X402_ASSET_SYMBOL=USDC

# Keep real CDP API keys in .env only. Do not commit them.
CDP_API_KEY_ID=organizations/{org_id}/apiKeys/{key_id}

# New CDP keys usually use an Ed25519 base64 secret, around 88 chars ending with ==.
# Legacy ES256 keys use PEM with escaped newlines.
CDP_API_KEY_SECRET=your_ed25519_base64_api_key_secret

# Optional shortcut for quick local checks. A manually generated CDP Bearer JWT
# can be used instead of CDP_API_KEY_ID/CDP_API_KEY_SECRET, but it expires quickly.
# CDP_BEARER_TOKEN=eyJ...
CDP_WALLET_SECRET=your_cdp_wallet_secret
CDP_EVM_ACCOUNT_NAME=agentspec-pay-to
