{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "es2022"
  },
  "include": ["next-env.d.ts", "src/**/*.js", "src/**/*.ts", "src/**/*.tsx", "src/**/*.jsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
